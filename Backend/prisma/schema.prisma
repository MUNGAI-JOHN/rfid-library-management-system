generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PatronStatus {
  PROBLEMATIC_PATRON
  NORMAL_PATRON
}

model Patron {
  id       Int          @id @default(autoincrement())
  fullName String
  rfid_uid String       @unique
  status   PatronStatus @default(NORMAL_PATRON)

  borrowingBooks  BorrowingBook[]
  entranceLogs    EntranceLogs[]
  exitLogs        ExitLogs[]
  shelfActivities ShelfActivity[]
  shelfSessions   SmartShelfSession[]
}

enum BookLocation {
  ON_SHELF
  IN_LIBRARY
  WITH_PATRON
}

model Book {
  id              Int             @id @default(autoincrement())
  bookTitle       String          @unique
  rfid_bid        String          @unique
  shelfId         Int
  location BookLocation @default(ON_SHELF)
  shelf           Shelf           @relation(fields: [shelfId], references: [id])
  borrowingBooks  BorrowingBook[]
  exitLogs        ExitLogs[]
  shelfActivities ShelfActivity[]
}

model Shelf {
  id          Int     @id @default(autoincrement())
  shelfName   String  @unique
  description String?

  books Book[]
}

model BorrowingBook {
  id Int @id @default(autoincrement())

  patronRfid String
  bookRfid   String

  borrowDate DateTime @default(now())
  dueDate    DateTime

  returned     Boolean   @default(false)
  returnedDate DateTime?

  patron Patron @relation(fields: [patronRfid], references: [rfid_uid])
  book   Book   @relation(fields: [bookRfid], references: [rfid_bid])
}

model EntranceLogs {
  id           Int      @id @default(autoincrement())
  patronRfid   String
  entranceTime DateTime @default(now())
  patron       Patron   @relation(fields: [patronRfid], references: [rfid_uid])
}

model ExitLogs {
  id             Int      @id @default(autoincrement())
  patronRfid     String
  bookRfid       String?
  bookAuthorized Boolean  @default(false)
  exitTime       DateTime @default(now())
  patron         Patron   @relation(fields: [patronRfid], references: [rfid_uid])
  book           Book?    @relation(fields: [bookRfid], references: [rfid_bid])
}

model ShelfActivity {
  id Int @id @default(autoincrement())

  patronRfid String
  bookRfid   String?

  imageUrl String?

  eventType ShelfEventType

  createdAt DateTime @default(now())

  patron Patron @relation(fields: [patronRfid], references: [rfid_uid])
  book   Book?  @relation(fields: [bookRfid], references: [rfid_bid])
}

enum ShelfEventType {
  PATRON_DETECTED
  BOOK_PICKED
  BOOK_RETURNED
  BOOK_BORROWED
  SECURITY_ALERT
}

model SmartShelfSession {
  id Int @id @default(autoincrement())

  patronRfid String

  startedAt DateTime @default(now())
  endedAt DateTime?

  active Boolean @default(true)

  patron Patron @relation(fields: [patronRfid],references: [rfid_uid])
}

enum NotificationType {
  SECURITY_ALERT
  PROBLEMATIC_PATRON
  UNAUTHORIZED_BOOK
  BOOK_BORROWED
  BOOK_RETURNED
  SYSTEM_ALERT
  INFO
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

model Notification {
  id              Int                  @id @default(autoincrement())
  title           String
  message         String
  type            NotificationType
  priority        NotificationPriority @default(NORMAL)
  isRead          Boolean              @default(false)

  patronRfid      String?
  bookRfid        String?
  shelfActivityId Int?

  createdAt       DateTime             @default(now())
}